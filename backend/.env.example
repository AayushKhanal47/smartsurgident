PORT=5002

# Set to "production" on any deployed host. In production the API issues
# Secure, SameSite=None session cookies (required when the SPA is on a
# different domain) and stops returning error stack traces.
NODE_ENV=development

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret

# Exact origin of the frontend (scheme + host + port, no trailing slash).
# CORS only allows this one origin, and it must be https in production for
# cross-site cookies to work.
CLIENT_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-gmail-app-password
