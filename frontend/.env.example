# API base URL, including the trailing /api. Vite inlines this at BUILD time,
# so it must be set in the build environment of your host — a production build
# made with the localhost value below will call localhost in the browser.
#   local dev:   http://localhost:5002/api
#   production:  https://your-api-host.example.com/api
VITE_API_URL=http://localhost:5002/api

# Main Smart Surgident WhatsApp number (digits only, with country code, no +
# or spaces — e.g. 9779800000000). Used by the site-wide WhatsApp button's
# "Chat with Smart Surgident Admin" option and the Contact page. Inlined at
# BUILD time like VITE_API_URL above.
VITE_WHATSAPP_ADMIN_NUMBER=9779800000000

# Cloudflare Turnstile site key (dash.cloudflare.com -> Turnstile -> add site).
# Renders the "I'm not a robot" widget on the Contact Us and Request a Quote
# forms. Leave unset to skip the widget locally; backend verification is
# skipped too when TURNSTILE_SECRET_KEY is unset there, so forms still work.
VITE_TURNSTILE_SITE_KEY=
