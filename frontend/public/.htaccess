# index.html (and the SPA root) must always be revalidated so a fresh
# deploy is visible immediately — Vite's hashed asset filenames change on
# every build, but index.html's own filename never does, so without this it
# gets cached like a static asset and a browser can keep serving yesterday's
# build for up to an hour (the host's default Cache-Control) after a deploy.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} == '/' || %{REQUEST_URI} =~ m#\.html$#">
    Header set Cache-Control "no-cache, must-revalidate"
  </If>

  # Content-Security-Policy (security audit finding M-6). The API host
  # already sends a strict Helmet-default CSP; this origin is the one that
  # actually serves the HTML documents browsers render, so it needs its own.
  # style-src allows 'unsafe-inline' because the app uses React's inline
  # `style={{...}}` in a few places (e.g. brand-colored icons) — same
  # pragmatic tradeoff the API's own Helmet default CSP already makes.
  Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://res.cloudinary.com; font-src 'self' data:; connect-src 'self' https://api.smartsurgident.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonicalize on https://www — apex and www previously both served 200
  # with no redirect, and a plain http:// request served content instead of
  # upgrading (SEO audit finding, P0: duplicate hosts split ranking signal
  # and let a crawler index either variant). This is the one place that
  # decides the canonical host; index.html's <link rel="canonical"> and the
  # sitemap generator both assume www is it.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://www.smartsurgident.com%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^smartsurgident\.com$ [NC]
  RewriteRule ^ https://www.smartsurgident.com%{REQUEST_URI} [L,R=301]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
